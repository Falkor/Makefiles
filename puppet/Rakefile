########################
#  Bootstrapping Tasks #
########################
namespace :bootstrap do
    ###########  bootstrap:modules   ###########
    desc "Initialize or update puppet modules according to the Puppetfile"
    task :modules do |t|
        info "#{t.comment}"
        run %{ r10k puppetfile install -v }
    end

    ###########   cert   ###########
    desc "Initiate a Puppet certificate on the master for HOST #{ENV['HOST']}"
    task :cert do |t|
        info "#{t.comment}"
        error("Use the HOST environment variable to set the target server for run puppet apply") unless ENV['HOST']
        h = ENV['HOST']
        m = ENV['MASTER'] ? ENV['MASTER'] : 'hpc-puppetmaster.uni.lux'
        run %{ ssh #{h} -- sudo /opt/puppetlabs/bin/puppet agent --verbose --test --waitforcert 60 }
    end # task cert

