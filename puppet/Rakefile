require 'falkorlib'
require 'pathname'
require 'rake/clean'
require 'ra10ke'

TOP_SRCDIR  = File.dirname(__FILE__)
DEPS_TMPDIR = '.deps'
PUPPET_MASTER_CLUSH_GROUP = '@puppet:master'

# Clean/globber tasks
CLEAN.include('**/*~')
CLOBBER.include(DEPS_TMPDIR)
CLOBBER.include("modules/*")

# Pre-checks
if FalkorLib::Common.command?('prsync')
    prsync_cmd='prsync'
elsif FalkorLib::Common.command?('parallel-rsync')
    prsync_cmd='parallel-rsync'
else
    FalkorLib::Common.error('prsync (parallel rsync), part of the pssh package, is not installed on your system and is required to deploy the puppet environment')
end

FalkorLib::Common.error('clush is not installed on your system and is required to deploy the puppet environment') unless FalkorLib::Common.command?('clush')
PUPPET_MASTER_HOSTLIST  = `nodeset -e #{PUPPET_MASTER_CLUSH_GROUP}`.chomp

## placeholder for custom configuration of FalkorLib.config.*
## See https://github.com/Falkor/falkorlib
# Git flow customization
FalkorLib.config.gitflow do |c|
    c[:branches] = {
                    :master  => 'production',
                    :develop => 'devel'
                   }
end

###### notify ######
# description
# Supported options:
#  * :force [boolean] force action
##
def do_notify(msg, options = {})
    options['title']   = 'Puppet Control Repo' unless options['title']
    options['sound']   = 'default'             unless options['sound']
    options['timeout'] = 4                     unless options['timeout']

    # notification command
    if (`uname`.chomp == 'Darwin')
        notify_cmd = "terminal-notifier -title '#{options['title']}' -sound '#{options['sound']}' -timeout #{options['timeout']} -message '#{msg}'"
    elsif (`uname`.chomp == 'Linux')
        notify_cmd='notify-send #{msg}'
    end
    system("#{notify_cmd}")
end # do_notify

require 'falkorlib/tasks/git'
