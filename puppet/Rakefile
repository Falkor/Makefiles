end # namespace bootstrap

###########   docs   ###########
desc "docs Run mkdocs for this project"
task :docs do |t|
    info "#{t.comment}"
    run %{ mkdocs serve }
end # task docs

##############
#  Git Tasks #
##############
#.....................
namespace :git do
    ###########   up   ###########
    desc "Pull the latest commit and merge then according to git-flow principles"
    task :up do |t|
        info "#{t.comment}"
        FalkorLib.config.gitflow[:branches].each do |t,br|
            run %{
         git checkout #{br}
         git pull origin #{br}
            }
        end
    end # task git:up
end # namespace git


########################
#  Puppet Puppet Tasks #
########################
namespace :puppet do
    ###########   puppet:bootstrap   ###########
    desc "Bootstrap puppet on HOST node #{ENV['HOST']}"
    task :bootstrap do |t|
        info "#{t.comment}"
        error("Use the HOST environment variable to set the target server for run puppet apply") unless ENV['HOST']
        h = ENV['HOST']
        m = ENV['MASTER'] if ENV['MASTER']
        # TODO: test command
        system("ssh #{h} -- uptime")
        error ("Unable to connect to host '#{h}' ") unless $?.exitstatus == 0
        c =  run %{ssh #{h} -- ping -c 1 #{m}}
        error ("Unable to connect to puppet master '#{m}' from host '#{h}'") unless c.to_i == 0
        info "transfer puppet installation script to #{h}"
        c = run %{ rsync -avzu #{TOP_SRCDIR}/bin/puppet_install.sh #{h}:/tmp/ }
        error ("Unable to transfer installation script to host '#{h}'") unless c.to_i == 0
        cmd = "sudo /tmp/puppet_install.sh --server #{m}"
        cmd += " --certname #{ENV['CERTNAME']}"     if ENV['CERTNAME']
        cmd += " --dns-alt-name #{ENV['HOST']}"
        cmd += ",#{ENV['ALTNAMES']}" if ENV['ALTNAMES']
        warning "About to install puppet agent targetting master #{m} using\n\t#{cmd}"
        really_continue?
        run %{ clush -w #{h} -- #{cmd} }
    end # task puppet:bootstrap

    # #.....................
    # namespace :apply do
    #   ###########   puppet:apply:$(whoami)   ###########
    #   desc "Run puppet apply using the current local repository status rsync"
    #   #task ENV['USER'].to_sym => ['r10k:local'] do |t|
    #   task ENV['USER'].to_sym => ['r10k:local'] do |t|
    #     info "#{t.comment}"
    #     error("Use the HOST environment variable to set the target server for run puppet apply") unless ENV['HOST']
