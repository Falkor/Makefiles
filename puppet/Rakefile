    #     puts h
    #     run %{ ssh #{h} -- /etc/puppetlabs/code/environments/#{ENV['USER']}/bin/papply --environment #{ENV['USER']} --noop}
    #     really_continue? "About to run WITHOUT the '--noop' option"
    #     run %{ ssh #{h} -- /etc/puppetlabs/code/environments/#{ENV['USER']}/bin/papply --environment #{ENV['USER']} }
    #     run %{ ssh }
    #   end # task local
    # end # namespace apply


    #.....................
    namespace :deploy do
        ['devel', 'production', ENV['USER'] ].each do |br|
            ###########   puppet:deploy:{devel,production,$(whoami)}   ###########
            desc "Deploy Puppet for environment '#{br}' on node(s) listed in HOST or CLUSH environement variable"
            task "#{br.to_sym}" do |t|
                Rake::Task['r10k:local'].invoke if br == ENV['USER']
                info "#{t.comment}"
                error("You should use the HOST or CLUSH environment variable to defined the target server(s) for running puppet agent") unless (ENV['HOST'] or ENV['CLUSH'])
                clush_opt = "-L -w #{ENV['HOST']}"   if ENV['HOST']
                clush_opt = "-L -w #{ENV['CLUSH']}"  if ENV['CLUSH']
                clush_opt = "-L -w #{ENV['GROUP']}"  if ENV['GROUP']
                cmd = "clush #{clush_opt} -- sudo /opt/puppetlabs/bin/puppet agent -vt --detailed-exitcodes --environment '#{br}'"
                info "Running in noop mode"
                really_continue?
                e = run %{ #{cmd} --noop}
                error("Runtime error with exit code #{e}") if [1,4,6].include?(e)
                info "About to run WITHOUT the '--noop' option"
                really_continue?
                e = run %{ #{cmd} }
                error("Runtime errorwith exit code #{e}") unless [0, 2].include?(e)
                do_notify "Successful run 'puppet agent' for the environment '#{br}' on #{clush_opt.gsub(/-w /,'')}"
            end # task puppet:deploy:{devel,production,$(whoami)}
        end

    end # namespace puppet:deploy
end # namespace puppet

#######################
#      eYaml tasks    #
#######################
#.....................
namespace :eyaml do
    ###########   debloy   ###########
    desc "Deploy the eYAML keys on the Puppet masters"
    task :deploy do |t|
        info "#{t.comment}"
        eyamldir   = '/etc/puppetlabs/puppet/eyaml'
        keydir     = "#{eyamldir}/keys"
        clush_opt  = "-w #{PUPPET_MASTER_CLUSH_GROUP}"
        prsync_opt = "-H \"#{PUPPET_MASTER_HOSTLIST}\""
        clush_opt  = "-m #{ENV['HOST']}" if ENV['HOST']
        prsync_opt = "-h #{ENV['HOST']}" if ENV['HOST']
        run %{ clush #{clush_opt} -- "if [ ! -d '#{keydir}' ]; then sudo mkdir -p #{keydir}; fi" }
        #run %{ git-crypt unlock }
        run %{ #{prsync_cmd} -avr #{prsync_opt} #{TOP_SRCDIR}/keys/ /var/lib/localadmin/ }
        run %{ clush #{clush_opt} -- "sudo mv ~localadmin/*_key.pkcs7.pem #{keydir} && sudo chown -R puppet:puppet #{keydir} &&  sudo chmod 0400 #{keydir}/* && sudo chmod 0500 #{eyamldir}"}
    end # task debloy

end # namespace eyaml


#######################
#      R10K tasks     #
#######################
namespace :r10k do
    namespace :deploy do
        local_branches = FalkorLib::Git.list_branch.select{|e| e !~ /remotes\//}

        ###########   r10k:deploy:all   ###########
        desc "Deploy all environment using R10k on the puppet master(s)"
        task :all do |t|
            info "#{t.comment}"
            run %{ clush -w #{PUPPET_MASTER_CLUSH_GROUP} -- sudo r10k deploy environment -vt }
            run %{ clush -w #{PUPPET_MASTER_CLUSH_GROUP} -- "sudo puppet generate types --environment production >/dev/null 2>&1" }
        end # task r10k:deploy:all

        local_branches.each do |br|
            ###########   r10k:deploy:{devel,production,...}   ###########
            desc "Deploy the '#{br}' environment using R10k on the puppet master(s)"
            task "#{br.to_sym}" do |t|
                info "#{t.comment}"
                run %{ clush -w #{PUPPET_MASTER_CLUSH_GROUP} -- sudo r10k deploy environment #{br} -vt }
                run %{ clush -w #{PUPPET_MASTER_CLUSH_GROUP} -- "sudo puppet generate types --environment #{br} >/dev/null 2>&1" }
            end # task name
        end

        #.....................
        namespace :modules do
            ###########    r10k:deploy:modules:all   ###########
            desc "Update all environments and theirs respective modules "
            task :all do |t|
                info "#{t.comment}"
                run %{ clush -w #{PUPPET_MASTER_CLUSH_GROUP} -- sudo r10k deploy environment --modules -vt }
            end # task all
            local_branches.each do |br|
                ###########   r10k:deploy::modules:{devel,production,...}   ###########
                desc "Deploy the '#{br}' environment using R10k on the puppet master(s)"
                task "#{br.to_sym}" do |t|
                    info "#{t.comment}"
                    run %{ clush -w #{PUPPET_MASTER_CLUSH_GROUP} -- sudo r10k deploy environment #{br} --modules -vt }
                end # task name
            end
        end # namespace r10k:deploy:modules
    end # namespace r10k:deploy

    ###########  r10k:local  ###########
    desc "local Deploy the special environment '#{ENV['USER']}' using rsync for quick checks"
    task :local do |t|
        info "#{t.comment}"
        envdir = '/etc/puppetlabs/code/environments/' + ENV['USER']
        clush_group = ENV['CLUSH'] ? ENV['CLUSH'] : "#{PUPPET_MASTER_CLUSH_GROUP}"
        hostfile  = ENV['CLUSH'] ? `nodeset -e #{ENV['CLUSH']}`.chomp : "#{PUPPET_MASTER_HOSTLIST}"
        run %{ clush -w #{clush_group} -- "if [ ! -d '#{envdir}' ]; then sudo mkdir #{envdir}; sudo chown localadmin: #{envdir}; fi" }
        run %{ #{prsync_cmd} -x "--exclude=.git/*" -avr -H "#{hostfile}" #{TOP_SRCDIR}/ #{envdir} }
        run %{ clush -w #{clush_group} -- "sudo puppet generate types --environment #{ENV['USER']} >/dev/null 2>&1" }
        do_notify "Successful deployment of the local environement '#{ENV['USER']}'"
    end # task r10k:local

    #.....................
    namespace :update do
        ###########   r10k:update:module   ###########
        desc "Update certain module across all environments"
        task :module do |t|
            info "#{t.comment}"
            list = ask("Enter the module(s) you wish to update across all environements")
            Dir.chdir(File.join(TOP_SRCDIR, 'modules'))
            current_list = Dir.glob('*').select { |e| File.directory?(e) }
            # check that the list exist
            list.split.each do |m|
                error("The puppet module #{m} does not exist") unless current_list.include?(m)
            end
            run %{ clush -w #{PUPPET_MASTER_CLUSH_GROUP} -- sudo r10k deploy module #{list} -vt }
        end # task r10k:update:module

    end # namespace r10k:update

end # namespace r10k


###########   setup   ###########
namespace :setup do
    #.....................
    namespace :git do
        ###########   setup:git:hooks   ###########
        desc "Initialize the local git hooks"
        task :hooks do |t|
            info "#{t.comment}"
            src_hookdir = File.join(TOP_SRCDIR, 'config', 'hooks')
            dst_hookdir = File.join(TOP_SRCDIR, '.git',   'hooks')
            [ 'pre-commit' ].each do |hook|
                src_hook = File.join(src_hookdir, 'pre-commit.git-crypt', 'pre-commit.git-crypt.sh')
                dst_hook = File.join(dst_hookdir, "#{hook}")
                relative_path_to_src_hook = Pathname.new(src_hook).relative_path_from(Pathname.new(dst_hookdir)).to_s
                run %{ ln -s #{relative_path_to_src_hook} #{dst_hook} } unless File.exists?( dst_hook )
            end
        end # task hooks
    end # namespace git
end # namespace setup


# complete the default setup task
task :setup => [ 'setup:git:hooks', 'bootstrap:modules' ]

Rake::Task['version:release'].enhance do
  Rake::Task["r10k:deploy:all"].invoke
  run %{ clush -w #{PUPPET_MASTER_CLUSH_GROUP} -- "sudo git --git-dir=/etc/puppetlabs/code/environments/production/.git fetch --tags" }
  run %{ clush -w #{PUPPET_MASTER_CLUSH_GROUP} -- "sudo git --git-dir=/etc/puppetlabs/code/environments/devel/.git      fetch --tags" }
end

